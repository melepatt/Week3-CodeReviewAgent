# OpenAI-compatible model endpoint. Replace placeholders only in an untracked .env file.
LLM_API_KEY=replace-with-local-secret
LLM_BASE_URL=https://provider.example/v1
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# GitHub reads work anonymously for public repositories, subject to lower rate limits.
GITHUB_READ_TOKEN=
GITHUB_WRITE_TOKEN=
ENABLE_GITHUB_PUBLISH=false

# Optional tracing; both values are required only when explicitly enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
